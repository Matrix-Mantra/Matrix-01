# ---- Gemini ---------------------------------------------------------------
# Local development: free key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-key-here
# On Cloud Run deploy.sh switches to Vertex AI instead (no key needed):
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Check the current Gemini model list and update these if newer models are available.
SPEECH_MODEL=gemini-3.8-flash
TRIAGE_MODEL=gemini-3.8-flash
REPORT_MODEL=gemini-3.8-flash
# Tried in order when the model above is busy or unavailable
FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# ---- Login ----------------------------------------------------------------
# dev = type any name (local testing). firebase = Google sign-in (use this on the real site).
AUTH_MODE=dev
# From Firebase console > Project settings > Your apps > Web app (these values are public by design)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# ---- Reviews storage --------------------------------------------------------
# sqlite = local file (development). firestore = Cloud Run (required there: Cloud Run disks are temporary).
STORE=sqlite

# ---- Maps (optional) ------------------------------------------------------
# Free Google Maps Embed API key -> shows the driving route inside the page. Without it, a pin map is shown
# and the "Get directions" button still opens the route in Google Maps.
MAPS_EMBED_API_KEY=
